{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-ummesabiha",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "portfolio.ummesabiha.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
